# Copia este archivo a .env (que no se versiona) y ajusta los valores.

# Clave de ejemplo, NO es secreta: para cualquier uso real genera una con
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=clave-falsa-de-ejemplo-no-usar-fuera-de-desarrollo

# 1 = modo desarrollo (reloj de demostración, bandeja simulada, cualquier host).
# Si no se define, DEBUG queda apagado.
DEBUG=1

# Solo se usa con DEBUG apagado; hosts separados por comas.
# ALLOWED_HOSTS=localhost,127.0.0.1
